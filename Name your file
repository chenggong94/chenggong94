<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>我的独属网页</title>
<style>
body{margin:0;font-family:system-ui;background:#f5f5f7;color:#222;line-height:1.6}
.wrap{max-width:680px;margin:0 auto;padding:32px 18px}
.card{background:#fff;border-radius:16px;padding:20px;margin:16px 0;box-shadow:0 6px 20px rgba(0,0,0,.06)}
h1{margin:0 0 8px}
a{color:#4f46e5;margin-right:14px}
button{border:0;border-radius:999px;padding:10px 16px;background:#4f46e5;color:#fff}
body.dark{background:#0f172a;color:#e5e7eb}
body.dark .card{background:#1e293b}
</style>
</head>
<body>
<div class="wrap">
  <div class="card">
    <h1>这里是有光</h1>
    <p>这是我的独属网页，正在慢慢开发。</p>
    <button id="btn">切换暗色</button>
  </div>
  <div class="card">
    <h2>关于我</h2>
    <p>喜欢编程、摄影、旅行。</p>
  </div>
  <div class="card">
    <h2>联系我</h2>
    <a href="mailto:you@example.com">邮箱</a>
    <a href="https://github.com/chenggong94">GitHub</a>
  </div>
</div>
<script>
const btn=document.getElementById('btn');
btn.onclick=()=>{
  document.body.classList.toggle('dark');
  btn.textContent=document.body.classList.contains('dark')?'切换亮色':'切换暗色';
};
</script>
</body>
</html>
